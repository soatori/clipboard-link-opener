{
  "manifest_version": 3,
  "name": "剪贴板链接打开",
  "version": "2.0.0",
  "description": "复制任何 App 或网页的分享文案后点开扩展，一键从剪贴板中提取真实链接并打开对应网页。",
  "permissions": ["clipboardRead"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "剪贴板链接打开",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
